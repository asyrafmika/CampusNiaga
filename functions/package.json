{
  "name": "campusniaga-functions",
  "private": true,
  "description": "CampusNiaga Cloud Functions: trusted backend logic",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-campusniaga \"npm run test:emulator:run\"",
    "test:emulator:run": "vitest run --config vitest.emulator.config.mts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}

rules_version = '2';

// CampusNiaga Cloud Storage rules.
// Default deny: every path is closed until a later phase opens it
// (product photos in Phase 2, application documents in Phase 3).
// See docs/data-dictionary.md for the planned Storage paths.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

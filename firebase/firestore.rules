rules_version = '2';

// CampusNiaga Cloud Firestore rules.
// Default deny: every collection is closed until a later commit opens it
// with tested rules. Privileged fields (roles, approvals, stock, allocation,
// rankings, audit logs) are written only by Cloud Functions via the Admin SDK,
// which bypasses these rules. See docs/data-dictionary.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

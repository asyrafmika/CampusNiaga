rules_version = '2';

// CampusNiaga Cloud Firestore rules.
// Default deny: a collection stays closed until a phase opens it with tested
// rules. Privileged fields (roles, approvals, stock, allocation, rankings,
// audit logs) are written only by Cloud Functions through the Admin SDK, which
// bypasses these rules. See docs/data-dictionary.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Custom claims are set only by trusted server code. Never grant access
    // from a document field such as users/{uid}.roleFlags, which is display only.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidName(name) {
      return name is string
        && name.size() <= 60
        && name.trim().size() > 0;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Profiles are created by syncStudentStatus and setStaffRole. An active
      // owner may change only their display name.
      allow update: if isOwner(uid)
        && resource.data.accountStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && isValidName(request.resource.data.name)
        && request.resource.data.updatedAt == request.time;
    }

    // Append-only and written by the server. Reviewer access arrives with
    // business applications in Phase 3.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
    }

    // Holds the email allowlist, so it isn't readable by students.
    match /config/{docId} {
      allow read: if isAdmin();
    }
  }
}

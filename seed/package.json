{
  "name": "campusniaga-seed",
  "private": true,
  "description": "CampusNiaga test data for the Firebase emulators. Never used against a real project.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-campusniaga \"npm run test:emulator:run\"",
    "test:emulator:run": "vitest run --config vitest.emulator.config.mts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}

# Normalize line endings: LF in the repository and working tree,
# except Windows-only scripts.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.jar  binary
